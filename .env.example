# Database
DB_PASSWORD=oferta_dev
DATABASE_URL=postgresql://oferta:oferta_dev@localhost:5432/oferta

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=dev_master_key

# JWT — generate strong secrets: openssl rand -base64 48
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
# Optional separate durable private-payload key; must match API and notification worker.
# Empty uses JWT_SECRET. Retain the key until pending reset emails have expired.
OUTBOX_SECRET=

# API
API_PORT=3001
API_URL=http://localhost:3001/api/v1

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image Service
IMAGE_SERVICE_PORT=4001
IMAGE_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_IMAGE_URL=http://localhost:4001
PUBLIC_URL=http://localhost:4001
# Internal API URL used by the image service to consume one-use upload permits.
IMAGE_AUTH_API_URL=http://localhost:3001/api/v1
# Set the same value on API and image service; if empty, both use JWT_SECRET.
IMAGE_SERVICE_SECRET=

# Notification Service
NOTIFICATION_SERVICE_PORT=3003
# Zepto Mail SMTP
SMTP_HOST=smtp.zeptomail.eu
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ofertasuksesi.com

# Storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CORS — comma-separated allowed origins
# Beta: ALLOWED_ORIGINS=https://beta.ofertasuksesi.com
# Prod:  ALLOWED_ORIGINS=https://ofertasuksesi.com,https://www.ofertasuksesi.com
ALLOWED_ORIGINS=http://localhost:3000
# Set only your controlled reverse-proxy IPs/CIDRs; leave empty for direct local access.
TRUSTED_PROXY_CIDRS=

# Cloudflare Turnstile — get keys from https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Environment
NODE_ENV=development
